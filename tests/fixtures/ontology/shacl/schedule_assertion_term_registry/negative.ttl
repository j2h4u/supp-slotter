@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ss: <https://j2h4u.github.io/supp-slotter/ontology/v1/> .

ss:unknown_value a ss:ScheduleAssertion ;
  ss:schedule_axis "intake" ;
  ss:schedule_value "not_registered" .
ss:unknown_axis a ss:ScheduleAssertion ;
  ss:schedule_axis "not_registered" ;
  ss:schedule_value "food_preferred" .

# food_preferred is registered on the intake axis, not timing.
ss:wrong_axis a ss:ScheduleAssertion ;
  ss:schedule_axis "timing" ;
  ss:schedule_value "food_preferred" .

# A fixture-local OntologyTerm must not extend the canonical registry.
<https://j2h4u.github.io/supp-slotter/ontology/v1/term/intake/not_registered> a ss:OntologyTerm .
<https://j2h4u.github.io/supp-slotter/ontology/v1/term/not_registered/food_preferred> a ss:OntologyTerm .
