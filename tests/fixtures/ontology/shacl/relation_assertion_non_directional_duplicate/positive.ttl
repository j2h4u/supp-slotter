@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ss: <https://j2h4u.github.io/supp-slotter/ontology/v1/> .

ss:first a ss:RelationAssertionRecord ;
  ss:id "first" ; ss:relation_type "supports" ;
  ss:source_selector ss:first_source ; ss:target_selector ss:first_target .
ss:second a ss:RelationAssertionRecord ;
  ss:id "second" ; ss:relation_type "supports" ;
  ss:source_selector ss:second_source ; ss:target_selector ss:second_target .
ss:first_source a ss:RelationAssertionSelector ; ss:category "kind" ; ss:term "mineral" .
ss:first_target a ss:RelationAssertionSelector ; ss:category "kind" ; ss:term "vitamin" .
ss:second_source a ss:RelationAssertionSelector ; ss:category "kind" ; ss:term "vitamin" .
ss:second_target a ss:RelationAssertionSelector ; ss:category "kind" ; ss:term "mineral" .

# A name selector resolves the full Magnesium family, while an entity selector
# resolves one form.  Their strict-subset endpoint keys are intentionally
# distinct and must not be reported as a duplicate.
ss:family a ss:RelationAssertionRecord ;
  ss:id "family" ; ss:relation_type "balance" ;
  ss:source_selector ss:family_source ; ss:target_selector ss:family_target .
ss:subset a ss:RelationAssertionRecord ;
  ss:id "subset" ; ss:relation_type "balance" ;
  ss:source_selector ss:subset_source ; ss:target_selector ss:subset_target .
ss:family_source a ss:RelationAssertionSelector ; ss:entity ss:family_entity .
ss:family_entity a ss:RelationAssertionEntitySelector ; ss:name "Magnesium" .
ss:subset_source a ss:RelationAssertionSelector ; ss:entity ss:subset_entity .
ss:subset_entity a ss:RelationAssertionEntitySelector ;
  ss:entity_id <https://j2h4u.github.io/supp-slotter/ontology/v1/substance/sub_3k09vfu199> .
ss:family_target a ss:RelationAssertionSelector ; ss:entity ss:family_target_entity .
ss:family_target_entity a ss:RelationAssertionEntitySelector ; ss:name "N-Acetyl Cysteine" .
ss:subset_target a ss:RelationAssertionSelector ; ss:entity ss:subset_target_entity .
ss:subset_target_entity a ss:RelationAssertionEntitySelector ;
  ss:entity_id <https://j2h4u.github.io/supp-slotter/ontology/v1/substance/sub_3k09vfu199> .
