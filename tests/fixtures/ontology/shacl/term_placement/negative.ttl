@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ss: <https://j2h4u.github.io/supp-slotter/ontology/v1/> .

ss:item ss:knowledge_assertions ss:assertion .
ss:assertion a ss:KnowledgeAssertion ;
  ss:knowledge_category "kind" ;
  ss:knowledge_value "not_registered" .

# botanical is registered under kind, not effect; membership alone is not
# enough to permit a value in a different knowledge predicate.
ss:wrong_category_item ss:knowledge_assertions ss:wrong_category_assertion .
ss:wrong_category_assertion a ss:KnowledgeAssertion ;
  ss:knowledge_category "effect" ;
  ss:knowledge_value "botanical" .
