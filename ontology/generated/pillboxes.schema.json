{
  "$id": "https://j2h4u.github.io/supp-slotter/ontology/v1/generated/pillboxes.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "minProperties": 1,
  "patternProperties": {
    "^[a-z][a-z0-9_]*$": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "type": "string"
        },
        "slots": {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "food": {
                "type": "boolean"
              },
              "label": {
                "minLength": 1,
                "type": "string"
              },
              "near": {
                "enum": [
                  "breakfast",
                  "day_meal",
                  "sleep",
                  "wake",
                  "workout_after",
                  "workout_before"
                ],
                "minLength": 1,
                "type": "string"
              },
              "order": {
                "minimum": 1,
                "type": "integer"
              }
            },
            "required": [
              "label",
              "order",
              "near",
              "food"
            ],
            "type": "object"
          },
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "type": "object"
        },
        "stack": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "label",
        "stack",
        "slots"
      ],
      "type": "object"
    }
  },
  "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]*$"
  },
  "title": "Supp Slotter canonical pillbox source contract",
  "type": "object",
  "x-supp-slotter-validation": {
    "slot_identity": {
      "scope": "global",
      "source": "<pillbox_key>.slots.<slot_key>",
      "uniqueness": "required"
    },
    "slot_order": {
      "field": "order",
      "minimum": 1,
      "scope": "pillbox",
      "source": "<pillbox_key>.slots.<slot_key>",
      "uniqueness": "required"
    },
    "stack_linkage": {
      "semantics": "required_reference",
      "source": "<pillbox_key>",
      "source_field": "stack",
      "target_class": "Stack"
    }
  }
}
