{
  "$id": "https://j2h4u.github.io/supp-slotter/ontology/v1/generated/dashboard.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
    {
      "required": [
        "benefit"
      ]
    },
    {
      "required": [
        "risk"
      ]
    }
  ],
  "properties": {
    "benefit": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "declares_context": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ],
      "uniqueItems": true
    },
    "description": {
      "minLength": 1,
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9_]*$",
      "type": "string"
    },
    "name": {
      "minLength": 1,
      "type": "string"
    },
    "risk": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "description"
      ],
      "type": "object"
    },
    "selectors": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "enum": [
              "context",
              "effect",
              "kind",
              "pathway",
              "quality",
              "risk",
              "role"
            ],
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          },
          "term": {
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_]*$",
            "type": "string"
          }
        },
        "required": [
          "category",
          "term"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "selectors"
  ],
  "title": "Supp Slotter canonical dashboard source contract",
  "type": "object"
}
