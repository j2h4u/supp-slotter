    "engine_contract": {
      "conformance_scenarios": [
        {
          "expected": "one entity_id resolves one ID; an unscoped sibling collision fails closed",
          "fixture": "selector_exact_form",
          "id": "selector_exact_form",
          "semantic": "selector_resolution"
        },
        {
          "expected": "known canonical term with no matching card returns empty",
          "fixture": "selector_empty_term",
          "id": "selector_empty_term",
          "semantic": "selector_resolution"
        },
        {
          "expected": "only authored daily/training partitions route, inactive and tracked_unassigned remain excluded, absent membership is unassigned, daily not_every_day is presented separately",
          "fixture": "stack_and_episodic",
          "id": "stack_and_episodic",
          "semantic": "stack_partition"
        },
        {
          "expected": "not_every_day remains in daily assignment and changes presentation grouping only",
          "fixture": "episodic_presentation",
          "id": "episodic_presentation",
          "semantic": "episodic_presentation"
        },
        {
          "expected": "every selected item is feasible in every slot of its unbounded logical domain",
          "fixture": "candidate_feasibility",
          "id": "candidate_feasibility",
          "semantic": "candidate_feasibility"
        },
        {
          "expected": "unique pressure maximum wins; equal pressure count uses integer per-domain squared loads, then stable item-ID and slot-order tuple",
          "fixture": "objective_tie",
          "id": "objective_tie",
          "semantic": "canonical_objective_and_tie_break"
        },
        {
          "expected": "only globally proved Optimal publishes a layout; every unproved result is layout-free Indeterminate",
          "fixture": "publication_status",
          "id": "publication_status",
          "semantic": "publication_boundary"
        },
        {
          "expected": "all four source/target active combinations map to declared statuses and warning sides",
          "fixture": "relation_presence",
          "id": "relation_presence",
          "semantic": "relation_warning_truth"
        }
      ],
      "domain_feasibility": "unbounded_logical_domain",
      "id": "planner_engine_contract",
      "pressure_identity": [
        "item_id",
        "dimension",
        "value"
      ],
      "primary_objective": "maximize_unique_pressure_satisfaction",
      "protocol_version": "supp-slotter.engine-contract/v2",
      "publication_statuses": [
        "Optimal",
        "Indeterminate"
      ],
      "result_mode": "exact_assignment",
      "secondary_objective": "minimize_integer_squared_load_per_domain",
      "semantics": [
        {
          "category": "selectors",
          "id": "selector_resolution",
          "rule": "entity_id resolves one stable card; name resolves all exact-name cards; term resolves all cards carrying the canonical term; empty and unsupported outcomes remain distinct; exact_form requires an entity_id and is required when same-name siblings exist.",
          "source_of_truth": "ontology/scheduling-model.yaml + ontology/vocabulary.yaml + verified substance cards"
        },
        {
          "category": "stack_state",
          "id": "stack_partition",
          "rule": "normalize each product into one authored partition; only declared routable daily/training partitions enter planning, while declared inactive and tracked-unassigned ownership partitions are excluded; absent membership is unassigned.",
          "source_of_truth": "data/stacks.yaml + ontology/runtime-policy.yaml"
        },
        {
          "category": "presentation",
          "id": "episodic_presentation",
          "rule": "use_pattern not_every_day remains in the daily scheduling stack and changes presentation grouping only; it does not define recurrence, dosage, or calendar semantics.",
          "source_of_truth": "ProductCard.use_pattern + data/products"
        },
        {
          "category": "search_inputs",
          "id": "candidate_feasibility",
          "rule": "each selected item is feasible in every slot belonging to its unbounded logical domain; no capacity, pair condition, numerical ranking, or physical-fit condition narrows the domain.",
          "source_of_truth": "pillbox slots + data/stacks.yaml + ontology/runtime-policy.yaml"
        },
        {
          "category": "optimization",
          "id": "canonical_objective_and_tie_break",
          "rule": "maximize unique pressure identities; then minimize the exact integer sum of squared loads independently within each unbounded domain; then minimize the assignment tuple ordered by stable item ID and (slot.order, slot_id).",
          "source_of_truth": "ontology/runtime-policy.yaml"
        },
        {
          "category": "publication",
          "id": "publication_boundary",
          "rule": "publish only Optimal results proved globally; conflicts, invalid inputs, interruption, timeout, or resource exhaustion are layout-free Indeterminate results.",
          "source_of_truth": "ontology/runtime-policy.yaml + canonical optimizer"
        },
        {
          "category": "warnings",
          "id": "relation_warning_truth",
          "rule": "active endpoint truth is intersection with components of products in non-inactive stacks; classify all four endpoint states; apply authored filters and active sides; preserve reverse output; deduplicate by endpoint/type key.",
          "source_of_truth": "ontology/runtime-policy.yaml + relation assertion projection"
        }
      ],
      "tie_break": "stable_item_id_then_(slot.order,slot_id)"
    },
